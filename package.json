{
  "name": "homeflix-native",
  "version": "1.0.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "android-tv:build": "cd apps/android-tv && ./gradlew assembleDebug",
    "android-tv:check": "cd apps/android-tv && ./gradlew ktlintCheck detekt lintDebug testDebugUnitTest assembleDebug",
    "android-tv:connected-test": "cd apps/android-tv && ./gradlew connectedDebugAndroidTest",
    "android-tv:install": "cd apps/android-tv && ./gradlew installDebug",
    "android-tv:lint": "cd apps/android-tv && ./gradlew ktlintCheck detekt lintDebug",
    "android-tv:mutation": "cd apps/android-tv && ./gradlew :core:designsystem:pitestDebug :core:network:pitestDebug :core:session:pitestDebug :feature:auth:pitestDebug :feature:detail:pitestDebug :feature:home:pitestDebug :feature:profile:pitestDebug",
    "android-tv:test": "cd apps/android-tv && ./gradlew testDebugUnitTest",
    "start": "pnpm --filter @homeflix/ios start",
    "ios": "pnpm --filter @homeflix/ios ios",
    "lint": "pnpm --filter @homeflix/ios lint",
    "typecheck": "pnpm --filter @homeflix/ios typecheck",
    "dup": "pnpm --filter @homeflix/ios dup",
    "test": "node --test \"scripts/**/*.test.js\" && pnpm --filter @homeflix/ios test",
    "check": "pnpm lint && pnpm typecheck && pnpm dup && pnpm test && pnpm audit --audit-level=low"
  }
}
