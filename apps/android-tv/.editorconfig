root = true

[*.{kt,kts}]
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
ij_kotlin_packages_to_use_import_on_demand = androidx.compose.foundation.layout.*,androidx.compose.runtime.*,androidx.compose.ui.*,androidx.compose.ui.draw.*,androidx.compose.ui.focus.*,androidx.compose.ui.graphics.*,androidx.compose.ui.unit.*,androidx.tv.material3.*,org.junit.jupiter.api.Assertions.*
