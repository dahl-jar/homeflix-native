    "check": "pnpm lint && pnpm typecheck && pnpm dup && pnpm test && pnpm audit --audit-level=low"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "57.0.15",
    "expo-blur": "57.0.2",
    "expo-constants": "57.0.13",
    "expo-crypto": "~57.0.2",
    "expo-image": "57.0.3",
    "expo-linear-gradient": "57.0.1",
    "expo-linking": "57.0.7",
    "expo-router": "57.0.15",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-video": "57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "eslint-plugin-import": "2.32.0",
    "globals": "17.6.0",
    "jscpd": "4.2.4",
    "typescript": "~6.0.3"
